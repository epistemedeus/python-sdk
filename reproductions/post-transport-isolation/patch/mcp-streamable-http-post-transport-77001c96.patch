+@pytest.mark.anyio
+@pytest.mark.parametrize("in_body", [False, True], ids=["sending", "reading-json-body"])
+@pytest.mark.parametrize(
+    "error",
+    [httpx2.ReadTimeout, httpx2.RemoteProtocolError, httpx2.ConnectError],
+    ids=["read-timeout", "remote-protocol", "connect"],
+)
+async def test_post_transport_error_fails_that_call_and_keeps_the_session(
+    in_body: bool, error: type[httpx2.TransportError]
+) -> None:
+    """A transport error on one request's POST fails only that call with CONNECTION_CLOSED.
+
+    The original exception reaches message_handler. The session stays usable. The failed
+    request is not replayed.
+    """
+    session_manager = StreamableHTTPSessionManager(app=Server("post-error-test", on_list_tools=_list_no_tools))
+    app = Starlette(routes=[Mount("/mcp", app=session_manager.handle_request)])
+    seen: list[object] = []
+    delivered = anyio.Event()
+
+    async def message_handler(message: object) -> None:
+        seen.append(message)
+        delivered.set()
+
+    transport = _FailPostsFor(app, "prompts/list", in_body=in_body, error=error)
+
+    with anyio.fail_after(5):
+        async with (
+            session_manager.run(),
+            httpx2.AsyncClient(transport=transport) as http,
+            Client(
+                streamable_http_client("http://mcp.example/mcp/", http_client=http),
+                message_handler=message_handler,
+            ) as client,
+        ):
+            with pytest.raises(MCPError) as exc_info:
+                await client.list_prompts()
+            assert (await client.list_tools()).tools == []
+            await delivered.wait()
+            assert not http.is_closed
+
+    assert exc_info.value.error.code == CONNECTION_CLOSED
+    assert exc_info.value.error.message == f"HTTP request failed: {error('simulated transport failure')!r}"
+    assert len(seen) == 1
+    assert isinstance(seen[0], error)
+    assert transport.posts.count("prompts/list") == 1
+
