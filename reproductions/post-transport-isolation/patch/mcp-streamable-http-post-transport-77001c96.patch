+class _BodyError(httpx2.AsyncByteStream):
+    def __init__(self, error: BaseException) -> None:
+        self._error = error
+
+    async def __aiter__(self) -> AsyncIterator[bytes]:
+        yield b"{"
+        raise self._error
+
+
+class _FailPostsFor(httpx2.AsyncBaseTransport):
+    """Serves `app` in process, except that a POST carrying `method` fails with a transport error:
+    raised while sending it, or (`in_body`) while reading its JSON response body."""
+
+    def __init__(
+        self,
+        app: Starlette,
+        method: str,
+        *,
+        in_body: bool = False,
+        error: type[httpx2.TransportError] = httpx2.ReadTimeout,
+    ) -> None:
+        self.inner = StreamingASGITransport(app)
+        self.method = method
+        self.in_body = in_body
+        self.error = error
+        self.posts: list[str] = []
+
+    async def handle_async_request(self, request: httpx2.Request) -> httpx2.Response:
+        await request.aread()
+        body = json.loads(request.content) if request.method == "POST" else {}
+        if request.method == "POST":
+            self.posts.append(body.get("method", ""))
+        if request.method == "POST" and body.get("method") == self.method:
+            exc = self.error("simulated transport failure")
+            if self.in_body:
+                return httpx2.Response(200, headers={"content-type": "application/json"}, stream=_BodyError(exc))
+            raise exc
+        return await self.inner.handle_async_request(request)
+
+    async def __aenter__(self) -> "_FailPostsFor":
+        await self.inner.__aenter__()
+        return self
+
+    async def __aexit__(self, *args: Any) -> None:
+        await self.inner.__aexit__(*args)
+
